# ========================================================
# Freelance Project Enquiry Form - Environment Variables
# ========================================================

# 1. Resend API Key (Get free key at https://resend.com)
# Free plan includes 3,000 emails/month (100 emails/day)
RESEND_API_KEY=re_your_api_key_here

# 2. Recipient Email (Where customer enquiries will be sent)
# Defaults to mmanikandan1322002@gmail.com if omitted
TO_EMAIL=mmanikandan1322002@gmail.com

# 3. Sender Address (From header)
# Use 'onboarding@resend.dev' for instant testing,
# or your verified custom domain once added to Resend (e.g. 'Enquiries <contact@yourdomain.com>')
FROM_EMAIL=Portfolio Enquiry <onboarding@resend.dev>
